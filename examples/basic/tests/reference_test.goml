package tests;

use ecosystem::testkit::reference;
use ecosystem::bigint::examples::basic as application;
use std::testing;
use std::fs;
use std::json;

fn field(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), "reference field " + name)
}

fn reference_rows() -> Vec[json::Value] {
    let source = reference::load_text(fixture_path("tests/data/reference.jsonl"));
    let rows = Vec::new();
    for line in source.split("\n") {
        if line != "" {
            rows.push(testing::expect_ok(json::parse(line), "reference JSON"));
        }
    }
    rows
}

#[test]
fn independent_integer_vectors() -> () {
    let rows = reference_rows();
    testing::assert_eq(rows.len(), 1938);
    for row in rows {
        let input = testing::expect_some(json::as_string(field(row, "input")), "input");
        let expected = testing::expect_some(json::as_string(field(row, "expected")), "expected");
        testing::assert_eq(application::reference_case(input), expected);
    }
}

fn fixture_path(path: string) -> string {
    if fs::is_dir("examples/basic") {
        "examples/basic/" + path
    } else {
        path
    }
}
