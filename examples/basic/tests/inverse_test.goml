package tests;

use ecosystem::bigint::{BigInt, BigUint};
use std::testing;

#[test]
fn public_inverse_solves_a_modular_equation() -> () {
    let modulus = BigUint::from_u64(101);
    let inverse = testing::expect_ok(BigInt::from_i64(-7).mod_inverse(modulus), "inverse").unwrap_or(
        BigUint::zero(),
    );
    let solution = testing::expect_ok(inverse.mul(BigUint::from_u64(13)).rem(modulus), "solution");
    testing::assert((solution.to_u64()) == (Option::Some(27)));
    testing::assert(
        (testing::expect_ok(BigUint::from_u64(6).mod_inverse(BigUint::from_u64(9)), "nonunit"))
            == (Option::None),
    );
}
